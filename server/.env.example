NODE_ENV=development
PORT=3001
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MONGODB_URI=mongodb://127.0.0.1:27017/text_to_learn?replicaSet=rs0
AUTH0_DOMAIN=your-tenant.region.auth0.com
AUTH0_AUDIENCE=https://text-to-learn-api
# Required for Week 2 generation. Choose a supported structured-output model.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=
# Optional Week 3 enhancements. Select a current supported Interactions speech model.
# Supported voices: Kore, Puck, Charon, Fenrir, Aoede, Zephyr, Orus, Leda.
GEMINI_TTS_MODEL=
GEMINI_TTS_VOICE=Kore
YOUTUBE_API_KEY=
